<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telcobright</groupId>
        <artifactId>routesphere-seed-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>seed-tenant</artifactId>
    <packaging>jar</packaging>
    <name>seed-tenant</name>
    <description>
        The tenant trees every product walks (the owner, 2026-10-09): one tree per sibling tenant in a map, every nested reseller its own
        DynamicContext inside the hierarchy, loaded through prime-context, a database change sensed by the Kafka doorbell. The map and the
        doorbell consumer are seed-context's; this module adds the tree loader, the lookup the session pipeline asks (TenantLookup, from the
        current snapshot, an id two tiers hold names nobody) and the doorbell ringer. seed-context stays generic; seed-sessionflow stays free
        of HTTP clients.
    </description>

    <properties>
        <jackson.version>2.19.2</jackson.version>
        <kafka.version>3.7.1</kafka.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-context</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-sessionflow</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>rtc-domain</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
