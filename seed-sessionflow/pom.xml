<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telcobright</groupId>
        <artifactId>routesphere-seed-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>seed-sessionflow</artifactId>
    <name>seed-sessionflow</name>
    <description>The base flow of a Telcobright switch, as a library (P1, design routesphere-flow.html, 2026-10-21):
        RoutesphereFlow, the ONE base of the ad, the voice call, the WiFi session and the SMS — the SessionHandler of statewalk
        4.0's final SessionSupervisor (IDLE · INIT · ADMITTING · ROUTING · CONNECTING · ACTIVE · SUCCEEDED | FAILED). The library
        keeps the states; the base keeps the routesphere lifecycle: the root tenant by its ingress (identifySiblingLevelTenants),
        the reseller tiers leaf to root (iterateResellerTenants, identifyEntryPartner, identifyPartner), routing, credit control
        through one ledger port (reserveBalance, finalizeCost), rerouting (handleRerouting) and the finish (finishSession: the CDR
        per tier, the task, the SDR). An application answers only its own questions. statewalk ${statewalk.version}; the ledger of
        orchestrix's prepaid roads is here too (OrchestrixLedger).</description>

    <properties>
        <jackson.version>2.19.2</jackson.version>
        <kafka.version>3.7.1</kafka.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>statewalk</artifactId>
            <version>${statewalk.version}</version>
        </dependency>
        <!-- the tenant tree, DynamicContext, Partner, LevelAdmission — the shape every switch shares -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>rtc-domain</artifactId>
            <version>1.0-SNAPSHOT</version>
            <!-- P1 §A: state-walk v1 stays out of the seed — rtc-domain carries it for its own CampaignTask entity, which the
                 seed never loads (the seed's task is seed-campaign's CampaignTask) -->
            <exclusions>
                <exclusion>
                    <groupId>com.telcobright</groupId>
                    <artifactId>state-walk</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-campaign</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- P1-M: the ONE cleaner of what goes into a log line (a request's value, a url's password), the seed's bottom module -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-logtext</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- R9: the platform topics (cdr_<root>, config_event_loader_<root>, tenant_created) and an application's own -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-naming</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <!-- the CDR road of every switch: one message per call on the tenant tree's cdr topic (KafkaCdrSink) -->
        <dependency>
            <groupId>org.apache.kafka</groupId>
            <artifactId>kafka-clients</artifactId>
            <version>${kafka.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
        <!-- §L.4's proof only: statewalk's JDBC store on an in-memory database, one table per lane (test scope; no runtime dependency) -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.2.224</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- *IT needs the local Kafka on 127.0.0.1:9092: it only runs with -Dseed.it=true -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-telcobright-statewalk</id>
            <url>https://maven.pkg.github.com/pialmmh/statewalk</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
