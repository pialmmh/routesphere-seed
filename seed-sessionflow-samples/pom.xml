<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telcobright</groupId>
        <artifactId>routesphere-seed-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>seed-sessionflow-samples</artifactId>
    <name>seed-sessionflow-samples</name>
    <description>The acceptance side of RoutesphereFlow (P1 §H, stream T) — test code only, nothing ships: the four signaling
        machines of the samples as statewalk 4.0 MachineSpecs, each with its fake channel and decoder (AdPlayback, EslCall,
        WifiGateway, SmsSubmit), the registry bed they run on, the four RoutesphereFlow samples (AdFlow, VoiceFlow, WifiFlow,
        SmsFlow) and the scenarios every sample runs. The machines depend on statewalk only; the samples on the base.</description>

    <properties>
        <!-- statewalk: the parent's ONE pin (4.0.0, P1 §A/§K). Nothing of this module is a library: its jar is empty. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!-- the base the four samples extend (RoutesphereFlow) and its testkit -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-sessionflow</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- L2a: the samples run sessions, and a session's money is seed-prepaid's engine (the base's kit finds its maker on the classpath:
             the base never moves money itself, design prepaid-engine-design.md §11) -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-prepaid</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- the trees per root with their doorbell (TenantTrees + the scripted source): the §D scenario of a sample -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>seed-tenant</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>statewalk</artifactId>
            <version>${statewalk.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-telcobright-statewalk</id>
            <url>https://maven.pkg.github.com/pialmmh/statewalk</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
