<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.telcobright</groupId>
    <artifactId>routesphere-seed-parent</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>routesphere-seed</name>
    <description>The Telcobright service seed: the good parts of routesphere as reusable libraries —
        per-tenant/per-channel config, cached entities, omniqueue — so new products (wifi-sphere, …)
        start small and stay small. Plain libraries + optional CDI wiring; deliberately NOT Quarkus
        extensions (see docs/DESIGN.md).</description>

    <modules>
        <module>seed-bom</module>
        <module>seed-config</module>
        <module>seed-config-client</module>
        <module>seed-context</module>
        <module>seed-campaign</module>
        <module>seed-routing</module>
        <module>seed-sessionflow</module>
        <!-- the acceptance side of RoutesphereFlow (P1 §H): the samples' signaling machines and scenarios; test code only -->
        <module>seed-sessionflow-samples</module>
        <module>seed-tenant</module>
        <module>seed-idgen</module>
        <module>seed-switch-ledger</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- P1 (2026-10-22): the ONE statewalk of the seed — 4.0.0 (tag v4.0.0): the final SessionSupervisor + SessionHandler,
             signaling machines with a mandatory up, one row per session. statewalk-v2 and state-walk v1 stay out of the seed.
             SW-41 (2026-10-23): 4.1 — the outbox (an up is never lost in a crash, R-1), ServiceEnd.detail, ACTIVE takes
             SignalingProgress, LONGTEXT on MariaDB, the PostgreSQL DDL lock. 4.1.0-SNAPSHOT until the owner releases 4.1.0. -->
        <statewalk.version>4.1.0-SNAPSHOT</statewalk.version>
    </properties>
</project>
