<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.telcobright</groupId>
        <artifactId>routesphere-seed-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>seed-callflow</artifactId>
    <name>seed-callflow</name>
    <description>The routed session flow of a Telcobright switch, as a library (design: ad-sphere docs/ad-as-call/AD-AS-CALL-DESIGN.md,
        2026-09-29): the session graph with PREPROCESSING in front (RoutedSessionSupervisor on statewalk 3.2.0), the multi-level
        chain admission that DEBITS every reseller tier (ChainAdmission), the ledger port on orchestrix portal-api's prepaid
        roads (OrchestrixLedgerBilling), and the per-tier CDR + campaign task + summary outbox row in ONE transaction
        (LevelCdrWriter). Ad-sphere rides it first; the call switch adopts it in a later local window. The entities come
        from rtc-domain; no framework in here.</description>

    <properties>
        <statewalk.version>3.2.0</statewalk.version>
        <jackson.version>2.19.2</jackson.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>statewalk</artifactId>
            <version>${statewalk.version}</version>
        </dependency>
        <!-- the tenant tree, DynamicContext, Partner, LevelAdmission — the shape every switch shares -->
        <dependency>
            <groupId>com.telcobright</groupId>
            <artifactId>rtc-domain</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.13</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.230</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.13</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>github-telcobright-statewalk</id>
            <url>https://maven.pkg.github.com/pialmmh/statewalk</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
</project>
